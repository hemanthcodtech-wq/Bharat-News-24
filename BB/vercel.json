{
  "functions": {
    "api/**/*.js": {
      "includeFiles": "{dist/index.html,index.html}"
    }
  },
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/article/:slug", "destination": "/api/article?slug=:slug" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
